{
  "log": { "level": "warn" },
  "inbounds": [
    {
      "type": "vless",
      "listen": "::",
      "listen_port": 443,
      "users": [{ "name": "delphi", "uuid": "REPLACE_WITH_UUID" }],
      "tls": {
        "enabled": true,
        "server_name": "www.google.com.hk",
        "reality": {
          "enabled": true,
          "handshake": { "server": "www.google.com.hk", "server_port": 443 },
          "private_key": "REPLACE_PRIVATE_KEY",
          "short_id": ["hk2025"]
        }
      }
    },
    {
      "type": "hysteria2",
      "listen": "::",
      "listen_port": 443,
      "users": [{ "name": "delphi", "password": "REPLACE_PASSWORD" }],
      "obfs": { "type": "salamander", "password": "delphi-hk-obfs" }
    }
  ],
  "outbounds": [{ "type": "direct" }]
}